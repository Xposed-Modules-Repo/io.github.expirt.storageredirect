<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.expirt.storageredirect"
    android:versionCode="17"
    android:versionName="2.22">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="33" />
    <!--
      MANAGE_EXTERNAL_STORAGE (Android 11+ / API 30+):
      Required for the module configuration UI and backup manager to read, write, create,
      and list directories across shared storage (/storage/emulated/0), including the fixed
      configuration directory (/storage/emulated/0/Android/media/uninviting), custom redirect
      target directories, and per-app backup archives. Without All-Files Access, Android Scoped
      Storage restricts file operations to media-only stores and blocks custom path creation.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      QUERY_ALL_PACKAGES (Android 11+ / API 30+):
      Required for MainActivity to enumerate installed applications on the device, display
      their labels and launcher icons, and allow users to select applications for per-app
      redirection rules and backup management. On API 30+, package visibility filtering hides
      non-system apps from PackageManager queries unless this permission is declared.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
      READ_EXTERNAL_STORAGE & WRITE_EXTERNAL_STORAGE (Android 5.0 - 10 / API 21 - 29):
      Required for backward compatibility on legacy Android releases where MANAGE_EXTERNAL_STORAGE
      does not exist. Scoped to maxSdkVersion="29" so that devices on API 30+ rely exclusively
      on MANAGE_EXTERNAL_STORAGE without requesting redundant runtime permissions.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:label="Storage Redirect"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:label="Storage Redirect"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:label="Storage Redirect"
            android:exported="false" />
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="Redirects any hooked app's storage to a custom folder. Open the app to choose what to redirect." />
        <meta-data android:name="xposedminversion" android:value="93" />
    </application>
</manifest>
